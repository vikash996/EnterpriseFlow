# Local PostgreSQL connection settings. Copy to .env and set a real local password.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enterpriseflow
DB_USERNAME=postgres
DB_PASSWORD=

# JWT secret must be at least 32 characters and must be unique per environment.
JWT_SECRET=replace-with-a-secure-32-character-minimum-secret
JWT_EXPIRATION_MS=3600000

# Next.js development server origin.
FRONTEND_URL=http://localhost:3000
